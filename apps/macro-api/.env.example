# Use a local .env file; never commit real credentials.
DATABASE_URL=postgres://macro:replace_with_local_password@localhost:5432/macro?sslmode=disable
# Alternatively supply PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE, PGSSLMODE.
FRED_API_KEY=
PORT=3000
INGEST_INTERVAL=6h

# Optional backend-only overrides for controlled source migrations (defaults are official NHNN pages/API).
# SBV_FX_URL=https://sbv.gov.vn/vi/tỷ-giá
# SBV_INTERBANK_URL=https://sbv.gov.vn/vi/lãi-suất1
# SBV_ARTICLES_URL=https://sbv.gov.vn/o/article/v1.0/articles

# S&P Global official public release URL(s), comma separated (one vintage per month).
# Select current releases from https://www.pmi.spglobal.com/ and update monthly.
# No licensed historical database or automatic redistribution is implied.
PMI_RELEASE_URLS=
# Optional official OMO results URL override.
# SBV_BILLS_URL=https://sbv.gov.vn/vi/nghiệp-vụ-thị-trường-mở
